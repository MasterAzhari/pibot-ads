# ---- Required ----
APP_URL=https://ads.pibot.io
# 32+ random characters: openssl rand -hex 32
APP_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Local dev only; docker-compose sets DATABASE_URL itself
DATABASE_URL=postgresql://pibot:password@localhost:5432/pibot_ads

# ---- Meta (Facebook, Instagram, Meta Ads) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# ---- Threads (same or separate Meta app; use the Threads App ID/secret) ----
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- TikTok (Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Until the app passes the TikTok audit, posts can only be SELF_ONLY (private). After approval: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---- TikTok Ads (TikTok for Business / Marketing API) ----
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=

# ---- AI (fill in the ones you want; called directly, no middleman) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1/

# Hour (Malaysia time) for the daily AI analysis
DAILY_ANALYSIS_HOUR=8
