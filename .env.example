# ---- Wajib ----
APP_URL=https://ads.pibot.io
# 32+ aksara rawak: openssl rand -hex 32
APP_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Hanya untuk dev tempatan; docker-compose set DATABASE_URL sendiri
DATABASE_URL=postgresql://pibot:password@localhost:5432/pibot_ads

# ---- Meta (Facebook, Instagram, Meta Ads) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# ---- Threads (app Meta yang sama atau lain, guna Threads App ID/secret) ----
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- TikTok (Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Sebelum app lulus audit TikTok, post hanya boleh SELF_ONLY (private). Lepas lulus: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ---- TikTok Ads (TikTok for Business / Marketing API) ----
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=

# ---- AI (isi yang mana mahu guna, sambung terus tanpa orang tengah) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1/

# Jam (waktu Malaysia) analisis AI harian
DAILY_ANALYSIS_HOUR=8
